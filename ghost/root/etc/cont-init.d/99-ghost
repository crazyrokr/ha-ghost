#!/command/with-contenv bashio
# ==============================================================================
# Home Assistant Add-on: Ghost
# The Ghost application ships inside the image (installed at build time,
# see the Dockerfile). This script prepares the persisted blog volume:
# a one-time cleanup of the legacy in-volume app layout, config
# generation on the first boot, the sqlite3 module check, and the url
# and database options. Re-runs are no-ops.
# GHOST_BLOG_DIR defaults to the add-on config directory.
# ==============================================================================
set -e

BLOG_DIR="${GHOST_BLOG_DIR:-/config/ghost}"
CONFIG_DIR="$(dirname "$BLOG_DIR")"
APP_DIR="${GHOST_APP_DIR:-/opt/ghost}"
GHOST_PORT="2368"

mkdir -p "$CONFIG_DIR"
# The container runs as root; hand the config volume to the ghost user.
if [ "$(id -u)" = "0" ]; then
    chown ghost:ghost "$CONFIG_DIR"
fi

# Earlier add-on versions installed the Ghost application into this volume
# (the versions/ tree and the .ghost-cli marker). The application now lives
# in the image, so drop those legacy files, keeping the user's content and
# config.
if [ -d "$BLOG_DIR/versions" ] || [ -f "$BLOG_DIR/.ghost-cli" ]; then
    rm -rf "$BLOG_DIR/versions" "$BLOG_DIR/.ghost-cli"
fi

# Ghost's internal root detection requires a 'current' directory in the
# working directory (the blog directory, where the config lives): point it
# at the image's application, refreshed on every boot so an add-on update
# (new app version) is picked up.
mkdir -p "$BLOG_DIR"
ln -sfn "${APP_DIR}/current" "${BLOG_DIR}/current"

# Read the add-on 'url' option. bashio reports missing options as the
# string 'null'; normalize anything unusable to empty.
URL="$(bashio::config url 2>/dev/null || true)"
case "${URL}" in
    "" | null | None | undefined) URL="" ;;
esac

if [ ! -f "$BLOG_DIR/config.production.json" ]; then
    mkdir -p "${BLOG_DIR}/content"
    # The installer creates the content subdirectories (data, logs, ...) and
    # links the built-in themes into the blog it installs; the application
    # was installed into the image, so seed the persisted content from it.
    cp -a "${APP_DIR}/content/." "${BLOG_DIR}/content/"
    if [ "$(id -u)" = "0" ]; then
        chown -R ghost:ghost "${BLOG_DIR}"
    fi

    # Ghost CLI with --no-setup generates no config; write the production
    # config once. The blog binds all interfaces so the add-on ingress and
    # the exposed port both reach it. The admin account is created by the
    # user through the /ghost/ setup page on first visit.
    if [ -n "${URL}" ]; then
        URL_LINE="\"url\": \"${URL}\","
    else
        URL_LINE=""
    fi
    # Ghost 5 reads the 'database' key (not 'db'), resolves relative paths
    # against the app directory, and ships a mysql default; so the content
    # path and the sqlite file must be absolute paths into the blog volume.
    cat > "$BLOG_DIR/config.production.json" <<EOF
{
${URL_LINE}
  "server": {
    "host": "0.0.0.0",
    "port": ${GHOST_PORT}
  },
  "process": {
    "title": "Ghost"
  },
  "logging": {
    "level": "INFO"
  },
  "paths": {
    "contentPath": "${BLOG_DIR}/content/"
  },
  "database": {
    "client": "sqlite3",
    "connection": {
      "filename": "${BLOG_DIR}/content/data/ghost.db"
    },
    "settings": {
      "busyRetryMax": 10000
    },
    "migrate": true
  }
}
EOF
    if [ "$(id -u)" = "0" ]; then
        chown ghost:ghost "$BLOG_DIR/config.production.json"
    fi
fi

# The sqlite3 driver ships with the image's application (installed at
# build time from the prebuilt binary, no C toolchain). Without it Ghost
# would exit silently and the s6 service would crash-loop without any log
# output, so verify on every boot (the blog's current/ symlink resolves
# into the image) and fail loudly if the image is broken.
if ! runuser -u ghost -- node -e "require('${BLOG_DIR}/current/node_modules/sqlite3')" 2>/dev/null; then
    echo "ghost: sqlite3 native module is missing from the image application (${APP_DIR}); the image is broken, report this" >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Add-on options
# Ghost's config loader (nconf) merges environment variables above config
# files, so the options are published into the s6 container environment,
# which the service script applies through with-contenv. The config file
# itself is only generated on the first boot, so the options must take
# effect through the environment to be changeable later.
# Without db_type=mysql the built-in sqlite database from the generated
# config file is used.
# ---------------------------------------------------------------------------
CONTAINER_ENV="${CONTAINER_ENV_DIR:-/run/s6/container_environment}"
mkdir -p "$CONTAINER_ENV"

# Publish the url option as the 'url' environment variable (lowercase:
# Ghost's nconf env source does not normalize case, and the config key is
# 'url'; without it an unset option falls back to the Ghost default
# http://localhost:2368, whose links and API references resolve to the
# visitor's own machine). Cleared when the option is empty, so a reset
# never leaves a stale origin behind.
rm -f "${CONTAINER_ENV}/url" 2>/dev/null
if [ -n "${URL}" ]; then
    printf '%s' "${URL}" > "${CONTAINER_ENV}/url"
fi

# Publish the logging transports: the application's production default
# is file-only, and the environment merges above the config file, so the
# application log is printed to the container console - what the add-on
# log tab and `docker logs` show - on every start, new or existing
# volumes alike (the service's stdout reaches the container console
# because the s6 service has no log/ directory).
printf '%s' '["stdout","stderr","file"]' > "${CONTAINER_ENV}/logging__transports"

DB_TYPE="$(bashio::config db_type 2>/dev/null || true)"
case "${DB_TYPE}" in
    "" | null | None | undefined) DB_TYPE="sqlite" ;;
esac
DB_HOST="$(bashio::config db_host 2>/dev/null || true)"
case "${DB_HOST}" in
    "" | null | None | undefined) DB_HOST="" ;;
esac
DB_PORT="$(bashio::config db_port 2>/dev/null || true)"
case "${DB_PORT}" in
    "" | null | None | undefined) DB_PORT="3306" ;;
esac
DB_USER="$(bashio::config db_user 2>/dev/null || true)"
case "${DB_USER}" in
    "" | null | None | undefined) DB_USER="" ;;
esac
DB_PASSWORD="$(bashio::config db_password 2>/dev/null || true)"
case "${DB_PASSWORD}" in
    "" | null | None | undefined) DB_PASSWORD="" ;;
esac
DB_NAME="$(bashio::config db_name 2>/dev/null || true)"
case "${DB_NAME}" in
    "" | null | None | undefined) DB_NAME="" ;;
esac

# Drop previously published variables: options may have been changed or
# reverted since the last start.
rm -f "${CONTAINER_ENV}/database__"* 2>/dev/null

if [ "${DB_TYPE}" = "mysql" ]; then
    if [ -z "${DB_HOST}" ] || [ -z "${DB_USER}" ] || [ -z "${DB_NAME}" ]; then
        echo "ghost: db_type is mysql, but db_host, db_user and db_name must all be set" >&2
        exit 1
    fi
    printf '%s' "mysql"                > "${CONTAINER_ENV}/database__client"
    printf '%s' "${DB_HOST}"           > "${CONTAINER_ENV}/database__connection__host"
    printf '%s' "${DB_PORT}"           > "${CONTAINER_ENV}/database__connection__port"
    printf '%s' "${DB_USER}"           > "${CONTAINER_ENV}/database__connection__user"
    printf '%s' "${DB_PASSWORD}"       > "${CONTAINER_ENV}/database__connection__password"
    printf '%s' "${DB_NAME}"           > "${CONTAINER_ENV}/database__connection__database"
fi
