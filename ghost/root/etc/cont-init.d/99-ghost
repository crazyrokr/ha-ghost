#!/command/with-contenv bashio
# ==============================================================================
# Home Assistant Add-on: Ghost
# The Ghost application ships inside the image (installed at build time,
# see the Dockerfile). This script prepares the persisted blog volume:
# a one-time cleanup of the legacy in-volume app layout, config
# generation on the first boot, the migration of the add-on-generated
# database section out of the config file, the sqlite3 module check, and
# the url, log, mail, and database options. Re-runs are no-ops.
# GHOST_BLOG_DIR defaults to the add-on config directory.
# ==============================================================================
set -e

BLOG_DIR="${GHOST_BLOG_DIR:-/config/ghost}"
CONFIG_DIR="$(dirname "$BLOG_DIR")"
APP_DIR="${GHOST_APP_DIR:-/opt/ghost}"
GHOST_PORT="2368"

mkdir -p "$CONFIG_DIR"
# The container runs as root; hand the config volume to the ghost user.
if [ "$(id -u)" = "0" ]; then
    chown ghost:ghost "$CONFIG_DIR"
fi

# Earlier add-on versions installed the Ghost application into this volume
# (the versions/ tree and the .ghost-cli marker). The application now lives
# in the image, so drop those legacy files, keeping the user's content and
# config.
if [ -d "$BLOG_DIR/versions" ] || [ -f "$BLOG_DIR/.ghost-cli" ]; then
    rm -rf "$BLOG_DIR/versions" "$BLOG_DIR/.ghost-cli"
fi

# Ghost's internal root detection requires a 'current' directory in the
# working directory (the blog directory, where the config lives): point it
# at the image's application, refreshed on every boot so an add-on update
# (new app version) is picked up.
mkdir -p "$BLOG_DIR"
ln -sfn "${APP_DIR}/current" "${BLOG_DIR}/current"

# Read the add-on 'url' option. bashio reports missing options as the
# string 'null'; normalize anything unusable to empty.
URL="$(bashio::config url 2>/dev/null || true)"
case "${URL}" in
    "" | null | None | undefined) URL="" ;;
esac

if [ ! -f "$BLOG_DIR/config.production.json" ]; then
    mkdir -p "${BLOG_DIR}/content"
    # The installer creates the content subdirectories (data, logs, ...) and
    # links the built-in themes into the blog it installs; the application
    # was installed into the image, so seed the persisted content from it.
    cp -a "${APP_DIR}/content/." "${BLOG_DIR}/content/"
    if [ "$(id -u)" = "0" ]; then
        chown -R ghost:ghost "${BLOG_DIR}"
    fi

    # Ghost CLI with --no-setup generates no config; write the production
    # config once. The blog binds all interfaces so the add-on ingress and
    # the exposed port both reach it. The admin account is created by the
    # user through the /ghost/ setup page on first visit.
    #
    # The config file carries no 'database' section: Ghost's config loader
    # merges the 'database' object of every store (config files, container
    # environment, the application's own defaults) into one on every read,
    # and a file-borne section cannot be removed through the environment
    # again - its sqlite 'filename' connection option would leak into an
    # external database connection, where the mysql2 driver warns about it
    # and will reject it in a future release. The database is configured
    # through the container environment instead, published below on every
    # start (and, for volumes created by earlier add-on versions, the
    # section is migrated out of the file, see further down).
    #
    # Ghost 5 resolves relative paths against the app directory, so the
    # content path must be an absolute path into the blog volume.
    if [ -n "${URL}" ]; then
        URL_LINE="\"url\": \"${URL}\","
    else
        URL_LINE=""
    fi
    cat > "$BLOG_DIR/config.production.json" <<EOF
{
${URL_LINE}
  "server": {
    "host": "0.0.0.0",
    "port": ${GHOST_PORT}
  },
  "process": {
    "title": "Ghost"
  },
  "logging": {
    "level": "INFO"
  },
  "paths": {
    "contentPath": "${BLOG_DIR}/content/"
  }
}
EOF
    if [ "$(id -u)" = "0" ]; then
        chown ghost:ghost "$BLOG_DIR/config.production.json"
    fi
fi

# Config files generated by earlier add-on versions still carry the sqlite
# 'database' section in the file (the section is kept out of new configs,
# see above); migrate those once by dropping the section - the built-in
# database is published through the container environment below instead.
# Only files that still carry the add-on-generated section are rewritten
# (a built-in sqlite client whose connection holds exactly the add-on's
# default database file), so a config the user edited by hand - a custom
# database file, a custom client, anything else - is left untouched.
if [ -f "$BLOG_DIR/config.production.json" ]; then
    node -e '
const fs = require("fs");
const [file, sqliteFile] = process.argv.slice(1);
let config;
try {
    config = JSON.parse(fs.readFileSync(file, "utf8"));
} catch (error) {
    process.exit(0);
}
const database = config && config.database;
const generated = database
    && database.client === "sqlite3"
    && database.connection
    && database.connection.filename === sqliteFile
    && Object.keys(database.connection).length === 1;
if (generated) {
    delete config.database;
    fs.writeFileSync(file, JSON.stringify(config, undefined, 2) + "\n");
}
' "$BLOG_DIR/config.production.json" "${BLOG_DIR}/content/data/ghost.db"
fi

# The sqlite3 driver ships with the image's application (installed at
# build time from the prebuilt binary, no C toolchain). Without it Ghost
# would exit silently and the s6 service would crash-loop without any log
# output, so verify on every boot (the blog's current/ symlink resolves
# into the image) and fail loudly if the image is broken.
if ! runuser -u ghost -- node -e "require('${BLOG_DIR}/current/node_modules/sqlite3')" 2>/dev/null; then
    echo "ghost: sqlite3 native module is missing from the image application (${APP_DIR}); the image is broken, report this" >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Add-on options
# Ghost's config loader (nconf) merges environment variables above config
# files, so the options are published into the s6 container environment,
# which the service script applies through with-contenv. The config file
# itself is only generated on the first boot, so the options must take
# effect through the environment to be changeable later.
# The database is configured through the environment as well (the config
# file carries no 'database' section, see above): without db_type=mysql
# the built-in sqlite database is published, like the mysql options.
# ---------------------------------------------------------------------------
CONTAINER_ENV="${CONTAINER_ENV_DIR:-/run/s6/container_environment}"
mkdir -p "$CONTAINER_ENV"

# Publish the url option as the 'url' environment variable (lowercase:
# Ghost's nconf env source does not normalize case, and the config key is
# 'url'; without it an unset option falls back to the Ghost default
# http://localhost:2368, whose links and API references resolve to the
# visitor's own machine). Cleared when the option is empty, so a reset
# never leaves a stale origin behind.
rm -f "${CONTAINER_ENV}/url" 2>/dev/null
if [ -n "${URL}" ]; then
    printf '%s' "${URL}" > "${CONTAINER_ENV}/url"
fi

# Read the add-on 'log_console' option (on by default). The application's
# production default logs to file only; with the option on, the stdout
# and stderr transports are published as well, so the application log is
# printed to the container console - what the add-on log tab and
# `docker logs` show - on every start, new or existing volumes alike (the
# service's stdout reaches the container console because the s6 service
# has no log/ directory). With the option off the variable is cleared,
# so only the file transport remains (the log files keep being written
# to the volume).
LOG_CONSOLE="$(bashio::config log_console 2>/dev/null || true)"
case "${LOG_CONSOLE}" in
    false | False | FALSE | 0) LOG_CONSOLE="false" ;;
    *) LOG_CONSOLE="true" ;;
esac

rm -f "${CONTAINER_ENV}/logging__transports" 2>/dev/null
if [ "${LOG_CONSOLE}" = "true" ]; then
    printf '%s' '["stdout","stderr","file"]' > "${CONTAINER_ENV}/logging__transports"
fi

DB_TYPE="$(bashio::config db_type 2>/dev/null || true)"
case "${DB_TYPE}" in
    "" | null | None | undefined) DB_TYPE="sqlite" ;;
esac
DB_HOST="$(bashio::config db_host 2>/dev/null || true)"
case "${DB_HOST}" in
    "" | null | None | undefined) DB_HOST="" ;;
esac
DB_PORT="$(bashio::config db_port 2>/dev/null || true)"
case "${DB_PORT}" in
    "" | null | None | undefined) DB_PORT="3306" ;;
esac
DB_USER="$(bashio::config db_user 2>/dev/null || true)"
case "${DB_USER}" in
    "" | null | None | undefined) DB_USER="" ;;
esac
DB_PASSWORD="$(bashio::config db_password 2>/dev/null || true)"
case "${DB_PASSWORD}" in
    "" | null | None | undefined) DB_PASSWORD="" ;;
esac
DB_NAME="$(bashio::config db_name 2>/dev/null || true)"
case "${DB_NAME}" in
    "" | null | None | undefined) DB_NAME="" ;;
esac

# Drop previously published variables: options may have been changed or
# reverted since the last start.
rm -f "${CONTAINER_ENV}/database__"* 2>/dev/null

if [ "${DB_TYPE}" = "mysql" ]; then
    if [ -z "${DB_HOST}" ] || [ -z "${DB_USER}" ] || [ -z "${DB_NAME}" ]; then
        echo "ghost: db_type is mysql, but db_host, db_user and db_name must all be set" >&2
        exit 1
    fi
    printf '%s' "mysql"                > "${CONTAINER_ENV}/database__client"
    printf '%s' "${DB_HOST}"           > "${CONTAINER_ENV}/database__connection__host"
    printf '%s' "${DB_PORT}"           > "${CONTAINER_ENV}/database__connection__port"
    printf '%s' "${DB_USER}"           > "${CONTAINER_ENV}/database__connection__user"
    printf '%s' "${DB_PASSWORD}"       > "${CONTAINER_ENV}/database__connection__password"
    printf '%s' "${DB_NAME}"           > "${CONTAINER_ENV}/database__connection__database"
else
    # The built-in SQLite database, published like the mysql options:
    # without the variables the application's own default (an unreachable
    # local mysql) would apply. Ghost's loader adds everything else the
    # sqlite driver needs (it ignores the mysql connection options that
    # its default config contributes to the merged object).
    printf '%s' "sqlite3" > "${CONTAINER_ENV}/database__client"
    printf '%s' "${BLOG_DIR}/content/data/ghost.db" > "${CONTAINER_ENV}/database__connection__filename"
fi

# ---------------------------------------------------------------------------
# Mail options
# Same mechanism as the database options: the variables are published into
# the s6 container environment, which Ghost's config loader merges above
# the config file. Ghost's mail settings are mail.from, mail.transport
# and mail.options (host, port, secure, authentication). With mail_host
# set the SMTP connection is published; without it the built-in direct
# transport is kept (only mail__from, when set, is published).
# ---------------------------------------------------------------------------
MAIL_TRANSPORT="$(bashio::config mail_transport 2>/dev/null || true)"
case "${MAIL_TRANSPORT}" in
    "" | null | None | undefined) MAIL_TRANSPORT="SMTP" ;;
esac
MAIL_HOST="$(bashio::config mail_host 2>/dev/null || true)"
case "${MAIL_HOST}" in
    "" | null | None | undefined) MAIL_HOST="" ;;
esac
MAIL_PORT="$(bashio::config mail_port 2>/dev/null || true)"
case "${MAIL_PORT}" in
    "" | null | None | undefined) MAIL_PORT="587" ;;
esac
MAIL_SECURE="$(bashio::config mail_secure 2>/dev/null || true)"
case "${MAIL_SECURE}" in
    true | True | TRUE | 1) MAIL_SECURE="true" ;;
    *) MAIL_SECURE="false" ;;
esac
MAIL_USER="$(bashio::config mail_user 2>/dev/null || true)"
case "${MAIL_USER}" in
    "" | null | None | undefined) MAIL_USER="" ;;
esac
MAIL_PASSWORD="$(bashio::config mail_password 2>/dev/null || true)"
case "${MAIL_PASSWORD}" in
    "" | null | None | undefined) MAIL_PASSWORD="" ;;
esac
MAIL_FROM="$(bashio::config mail_from 2>/dev/null || true)"
case "${MAIL_FROM}" in
    "" | null | None | undefined) MAIL_FROM="" ;;
esac

# Drop previously published variables: options may have been changed or
# reverted since the last start.
rm -f "${CONTAINER_ENV}/mail__"* 2>/dev/null

if [ -n "${MAIL_HOST}" ]; then
    printf '%s' "${MAIL_TRANSPORT}"  > "${CONTAINER_ENV}/mail__transport"
    printf '%s' "${MAIL_HOST}"       > "${CONTAINER_ENV}/mail__options__host"
    printf '%s' "${MAIL_PORT}"       > "${CONTAINER_ENV}/mail__options__port"
    if [ "${MAIL_SECURE}" = "true" ]; then
        printf '%s' "true"           > "${CONTAINER_ENV}/mail__options__secure"
    fi
    if [ -n "${MAIL_USER}" ]; then
        printf '%s' "${MAIL_USER}"   > "${CONTAINER_ENV}/mail__options__auth__user"
    fi
    if [ -n "${MAIL_PASSWORD}" ]; then
        printf '%s' "${MAIL_PASSWORD}" > "${CONTAINER_ENV}/mail__options__auth__pass"
    fi
fi
if [ -n "${MAIL_FROM}" ]; then
    printf '%s' "${MAIL_FROM}" > "${CONTAINER_ENV}/mail__from"
fi
