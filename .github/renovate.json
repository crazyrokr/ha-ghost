{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "pinDigests": true,
  "packageRules": [
    {
      "matchPackageNames": ["ghcr.io/hassio-addons/**"],
      "groupName": "base images",
      "groupSlug": "base-images",
      "schedule": ["at any time"]
    }
  ]
}
